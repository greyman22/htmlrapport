# Kopiera till .env och fyll i. .env är ignorerad av git.
STRAPI_URL=http://localhost:1337
# Frontend where a published Article can be opened.
STRAPI_PUBLIC_URL=http://localhost:3001
# API-token från Strapi admin (Settings > API Tokens). Läsning av modellen kräver
# behörighet till Content-Type Builder (full access); utkast kräver create på Article.
STRAPI_API_TOKEN=
